# Copy to secrets.yaml (git-ignored) and fill in.
wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

# 32-byte base64 key; generate one at https://esphome.io/components/api.html or with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
musicspot_api_key: "REPLACE_WITH_BASE64_KEY"
musicspot_ap_password: "fallback-ap-password"
